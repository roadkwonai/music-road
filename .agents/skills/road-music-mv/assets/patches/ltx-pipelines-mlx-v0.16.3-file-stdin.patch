+def _run_ffmpeg_with_input(cmd: list[str], data: bytes | None, timeout: int):
+    # 큰 stdin PIPE 쓰기 중 stderr 배출이 막히지 않도록 일반 파일로 전달한다.
+    with tempfile.TemporaryFile() as input_file:
+        if data is not None:
+            input_file.write(data)
+            input_file.seek(0)
+        return subprocess.run(cmd, stdin=input_file if data is not None else None, capture_output=True, timeout=timeout)
 
 

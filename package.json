{
  "name": "road-music",
  "productName": "Road Music",
  "version": "1.4.3",
  "description": "Road Music - 로컬 GPU로 노래를 만드는 무료 AI 작곡 프로그램",
  "main": "electron/main.js",
  "bin": {
    "road-music": "cli/road-music.js"
  },
  "files": [
    "AGENTS.md",
    "CLAUDE.md",
    "cli/*.js",
    "electron/*.js",
    "renderer/*.js",
    "renderer/*.css",
    "renderer/*.html",
    "renderer/locales/*.js",
    "python/*.py",
    "python/LICENSE*.txt",
    "build/icon.*",
    "README.md",
    "LICENSE",
    "docs/cli.md",
    "docs/cli-reference.md",
    "docs/cli-design.md",
    "docs/cli-qa-report.md",
    "docs/cli-install.md",
    "docs/ai-cli.md",
    "docs/quickstart.md",
    "docs/project-guide.md",
    "docs/updates.md",
    "docs/music-options.md",
    "docs/genre-prompts.md",
    "docs/music-research.md",
    "docs/ace-prompt-guide.md",
    "docs/lyrics-tags.md",
    "docs/music-review.md",
    "docs/vendor/ace-step-1.5/**",
    "skills/road-music-ace/**",
    "prompts/ace-review.md",
    "prompts/cli-workflows.md",
    "docs/getting-started.md",
    "docs/guide.md",
    "docs/packaging.md"
  ],
  "author": "하이밸류연구소",
  "homepage": "https://roadkwon.dev",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "cli": "node cli/road-music.js",
    "test": "node --test tests/*.test.js",
    "dist:cli": "node scripts/package-cli.js",
    "release:assets": "node scripts/release-assets.js",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "dev.roadkwon.roadmusic",
    "files": [
      "cli/**",
      "electron/**",
      "renderer/**",
      "python/**",
      "!python/__pycache__/**",
      "build/icon.png",
      "LICENSE"
    ],
    "asarUnpack": [
      "python/**",
      "electron/spectrum-worker.js",
      "electron/spectrum-analysis.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "RoadMusic-${version}-mac-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.15.3"
  }
}
